{
	"name": "notes",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && prisma generate && vite build",
		"build:migrate": "svelte-kit sync && prisma generate && prisma migrate deploy && vite build",
		"build:tsc": "tsc --noEmit",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --coverage",
		"test:unit": "vitest",
		"test:playwright": "playwright test",
		"test:playwright:offline": "playwright test --config playwright.offline.config.ts",
		"lint": "prettier . --check . && eslint . && pnpm lint:css",
		"lint:css": "stylelint \"**/*.{css,svelte}\"",
		"lint-staged": "lint-staged --concurrent false",
		"format": "prettier . --write .",
		"prepare": "husky",
		"postinstall": "svelte-kit sync && prisma generate"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "10.0.1",
		"@faker-js/faker": "10.5.0",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.2.0",
		"@typescript-eslint/eslint-plugin": "8.66.0",
		"@typescript-eslint/parser": "8.66.0",
		"@vitest/coverage-v8": "4.1.10",
		"dotenv": "17.4.2",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.9.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"postcss": "8.5.26",
		"postcss-html": "2.0.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"prisma": "7.9.0",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-tailwindcss": "1.0.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.5",
		"svelte-eslint-parser": "1.8.0",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	},
	"type": "module",
	"dependencies": {
		"@47ng/cloak": "1.2.0",
		"@auth0/auth0-spa-js": "2.24.1",
		"@aws-sdk/client-ses": "3.1106.0",
		"@fontsource-variable/figtree": "5.3.0",
		"@fontsource/poppins": "5.3.0",
		"@lucide/svelte": "1.30.0",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "7.9.1",
		"@sentry/sveltekit": "10.69.0",
		"@tiptap/core": "3.29.2",
		"@tiptap/extension-hard-break": "3.29.2",
		"@tiptap/extension-list": "3.29.2",
		"@tiptap/extension-placeholder": "3.29.2",
		"@tiptap/pm": "3.29.2",
		"@tiptap/starter-kit": "3.29.2",
		"bits-ui": "2.18.1",
		"idb-keyval": "6.3.0",
		"jose": "6.2.8",
		"nanoid": "6.0.1",
		"neverthrow": "8.2.0",
		"pg": "8.23.0",
		"svelte-sonner": "1.1.1",
		"zod": "4.4.3"
	},
	"lint-staged": {
		"*": [
			"prettier . --write",
			"eslint ."
		],
		"*.{css,svelte}": [
			"stylelint --fix"
		]
	},
	"engines": {
		"node": "24.x"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@11.20.0"
}
